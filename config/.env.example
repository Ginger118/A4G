# Copy this file to enterprise-agent/.env. Never commit the real .env.
AGENT_API_BASE=https://api.deepseek.com
AGENT_API_KEY=
AGENT_MODEL=deepseek-flash
AGENT_VISION_MODEL=deepseek-flash
# Optional alternative runtime directory; default is .runtime/ inside the project.
# AGENT_RUNTIME_DIR=/absolute/path/to/runtime

# Default profile runs locally; no external vector/object services required.
AGENT_VECTOR_BACKEND=memory
AGENT_OBJECT_BACKEND=local
# Enterprise adapter profile (install uv sync --extra enterprise first).
AGENT_MILVUS_URI=http://127.0.0.1:19530
AGENT_MINIO_ENDPOINT=127.0.0.1:9000
AGENT_MINIO_BUCKET=a4g-originals
AGENT_MINIO_SECURE=true
AGENT_MINIO_ACCESS_KEY=
AGENT_MINIO_SECRET_KEY=

# Conservative UTF-8 estimate for ordinary streaming chat input (not exact model tokens).
AGENT_CHAT_CONTEXT_BUDGET=24000
